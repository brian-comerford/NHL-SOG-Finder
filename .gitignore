# Python
__pycache__/
*.pyc
.venv/

# Data pipeline output (rebuilt by scripts/generate_data.py on every CI run)
data/*
!data/.gitkeep
# ...except pick history, which CI commits back: it's the only record of
# what the model recommended before each game, and can't be rebuilt later.
!data/history/
# ...and the box-score cache behind the position rankings, so each run only
# fetches new games instead of re-downloading the whole season.
!data/cache/

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/public/data/
frontend/*.tsbuildinfo

# Editors / OS
.DS_Store
.vscode/
